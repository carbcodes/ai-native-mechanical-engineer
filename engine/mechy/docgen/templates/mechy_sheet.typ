// Mechy drawing-sheet style (docs/architecture/ui-style.md): paper, hairlines, monospace labels,
// a title block on every page. Shared by build_guide.typ and report.typ. Generated by `mechy doc build`;
// edit the template in engine/mechy/docgen/templates/, not the copy next to the PDF.

#let paper = rgb("#F5F5F3")   // default; meta.paper (mechy doc build --print: #FFFFFF) wins
#let ink = rgb("#1C1C1C")
#let muted = rgb("#6B6B6B")
#let faint = rgb("#1C1C1C").transparentize(88%)
#let accent = rgb("#20A4F3")
#let good = rgb("#1E7F4F")
#let danger = rgb("#C8102E")
#let mono = ("JetBrains Mono", "IBM Plex Mono", "SF Mono", "Menlo", "DejaVu Sans Mono")
#let sans = ("Inter", "Helvetica Neue", "Helvetica", "Arial", "DejaVu Sans")
#let hair = 0.4pt + ink
#let hair-muted = 0.3pt + muted

#let lbl(t) = text(font: mono, size: 5.5pt, tracking: 0.08em, fill: muted, upper(str(t)))
#let val(t, size: 7.5pt) = text(font: mono, size: size, fill: ink, str(t))
#let boxed(t, size: 7pt) = box(stroke: 0.6pt + ink, inset: (x: 4pt, y: 2.5pt),
  text(font: mono, size: size, tracking: 0.1em, if type(t) == str { upper(t) } else { t }))
#let status(s) = {
  let s = str(s)
  let c = if s == "PASS" { good } else if s == "FAIL" { danger } else { muted }
  box(stroke: 0.5pt + c, inset: (x: 3pt, y: 1.5pt), text(font: mono, size: 6pt, fill: c, tracking: 0.08em, s))
}
#let fmt(x, d: 2) = {
  if type(x) == str { return x }
  if x == none { return "-" }
  let p = calc.pow(10, d)
  let r = calc.round(x * p) / p
  let s = str(r)
  if d > 0 {
    let parts = s.split(".")
    let frac = if parts.len() > 1 { parts.at(1) } else { "" }
    s = parts.at(0) + "." + frac + "0" * (d - frac.len())
  }
  s
}
#let pct(x, d: 1) = fmt(x * 100, d: d) + "%"

// title block (bottom right); values come from the last `<sheet>` metadata on or before this page
#let title-block(meta) = context {
  let ms = query(selector(<sheet>).before(here()))
  let m = if ms.len() > 0 { ms.last().value } else { (title: meta.doc, scale: "NTS") }
  let n = counter(page).get().first()
  let total = counter(page).final().first()
  let cell(l, v, size: 7.5pt) = block(inset: (x: 3pt, y: 2.2pt), width: 100%)[#lbl(l) \ #val(v, size: size)]
  place(bottom + right, dx: -10mm, dy: -10mm, block(width: 178mm, fill: rgb(meta.at("paper", default: "#F5F5F3")), stroke: 0.8pt + ink,
    grid(columns: (24mm, 1fr, 22mm, 20mm, 24mm, 20mm), rows: (11mm, 9mm), stroke: hair,
      grid.cell(rowspan: 2, align: center + horizon,
        text(font: mono, size: 9pt, weight: "bold", tracking: 0.2em)[MECHY]),
      grid.cell(colspan: 5, cell("sheet title", upper(m.title), size: 9pt)),
      cell("project", meta.project), cell("variant", upper(meta.variant)), cell("scale", m.scale),
      cell("date", meta.date), cell("sheet", str(n) + " / " + str(total)),
    )))
  place(bottom + left, dx: 11mm, dy: -11mm, text(font: mono, size: 5pt, fill: muted, tracking: 0.06em,
    upper(meta.doc + "  ·  " + meta.footer)))
}

#let frame() = {
  let dots = tiling(size: (5mm, 5mm))[#place(dx: 2.4mm, dy: 2.4mm, circle(radius: 0.14mm, fill: faint))]
  place(top + left, dx: 6mm, dy: 6mm, rect(width: 100% - 12mm, height: 100% - 12mm, stroke: 0.4pt + ink))
  place(top + left, dx: 10mm, dy: 10mm, rect(width: 100% - 20mm, height: 100% - 20mm, stroke: 0.9pt + ink,
    fill: dots))
  // zone markers between the two borders
  for (i, z) in ("1", "2", "3", "4", "5", "6").enumerate() {
    let x = 10mm + (277mm / 6) * (i + 0.5)
    place(top + left, dx: x - 1mm, dy: 6.8mm, text(font: mono, size: 5pt, fill: muted, z))
    place(top + left, dx: x - 1mm, dy: 210mm - 9.6mm, text(font: mono, size: 5pt, fill: muted, z))
  }
  for (i, z) in ("A", "B", "C", "D").enumerate() {
    let y = 10mm + (190mm / 4) * (i + 0.5)
    place(top + left, dx: 7.4mm, dy: y - 1mm, text(font: mono, size: 5pt, fill: muted, z))
    place(top + left, dx: 297mm - 9.2mm, dy: y - 1mm, text(font: mono, size: 5pt, fill: muted, z))
  }
}

#let setup(meta, body) = {
  set document(title: meta.doc + " " + meta.variant, author: "mechy doc build")
  set page(paper: "a4", flipped: true, fill: rgb(meta.at("paper", default: "#F5F5F3")), margin: (left: 14mm, right: 14mm, top: 14mm, bottom: 35mm),
    background: frame(), foreground: title-block(meta))
  set text(font: sans, size: 8pt, fill: ink, lang: "en")
  set par(leading: 0.55em, spacing: 0.9em, justify: false)
  set table(stroke: none, inset: (x: 3pt, y: 2.4pt))
  show raw: set text(font: mono, size: 6.5pt)
  body
}

// One sheet: optional page break, the title-block metadata, a boxed sheet number and a title rule.
#let sheet(title, scale: "NTS", tag: none, first: false, body) = {
  if not first { pagebreak(weak: true) }
  [#metadata((title: title, scale: scale, tag: tag)) <sheet>]
  block(width: 100%, below: 4mm, {
    grid(columns: (auto, 1fr, auto), column-gutter: 3mm, align: horizon,
      boxed(context str(counter(page).get().first())),
      text(font: sans, size: 13pt, weight: "medium", title),
      lbl(if tag != none { tag } else { "" }))
    v(1.2mm)
    line(length: 100%, stroke: hair)
  })
  body
}

#let section(t) = block(above: 3.2mm, below: 1.8mm, text(font: mono, size: 6.5pt, weight: "bold",
  tracking: 0.12em, upper(t)))

// Hairline table; rows are arrays of strings/content. `aligns` per column.
#let dtable(columns: auto, header: (), rows: (), aligns: auto, size: 6.6pt, footer: none) = {
  let n = header.len()
  table(columns: columns, align: aligns,
    stroke: (x, y) => (bottom: if y == 0 { 0.6pt + ink } else { 0.25pt + faint }),
    table.header(..header.map(h => lbl(h))),
    ..rows.flatten().map(c => text(font: mono, size: size, if type(c) == str { c } else if c == none { "-" } else { c })),
    ..if footer != none { footer.map(c => table.cell(stroke: (top: 0.6pt + ink), text(font: mono, size: size,
      weight: "bold", c))) } else { () },
  )
}

// Numbered notes, like the NOTES list on a drawing: [1] text
#let notes(items, start: 1) = {
  for (i, it) in items.enumerate() {
    block(below: 1.6mm, grid(columns: (7mm, 1fr), column-gutter: 1mm,
      text(font: mono, size: 6.5pt, "[" + str(i + start) + "]"), text(size: 7.5pt, it)))
  }
}

#let steps-list(items) = {
  for (i, it) in items.enumerate() {
    block(below: 2mm, breakable: false, grid(columns: (8mm, 1fr), column-gutter: 1mm,
      box(stroke: 0.5pt + ink, inset: (x: 2pt, y: 1.2pt), text(font: mono, size: 6.5pt, str(i + 1))),
      text(size: 8pt, it)))
  }
}

#let stat(l, v, note: none) = block(below: 2.5mm, {
  lbl(l)
  linebreak()
  text(font: mono, size: 12pt, v)
  if note != none { h(2mm); text(font: mono, size: 6pt, fill: muted, note) }
})
