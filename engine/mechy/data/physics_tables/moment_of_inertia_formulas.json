{
  "meta": {
    "description": "Mass moments of inertia for common rigid bodies. Expressions are Python syntax (math module names allowed: pi, sqrt, ...). All SI.",
    "schema": "formulas[].outputs.<name>.expr evaluated with formulas[].variables",
    "source_url": "https://en.wikipedia.org/wiki/List_of_moments_of_inertia",
    "value_type": "handbook_typical"
  },
  "formulas": [
    {"id": "point_mass", "name": "Point mass at radius r", "variables": {"m": {"unit": "kg", "desc": "mass"}, "r": {"unit": "m", "desc": "distance to axis"}},
     "outputs": {"I": {"expr": "m*r**2", "unit": "kg*m^2"}}},
    {"id": "thin_ring_axial", "name": "Thin ring/hoop about central axis", "variables": {"m": {"unit": "kg", "desc": "mass"}, "r": {"unit": "m", "desc": "radius"}},
     "outputs": {"I": {"expr": "m*r**2", "unit": "kg*m^2"}}},
    {"id": "thin_ring_diameter", "name": "Thin ring about a diameter", "variables": {"m": {"unit": "kg", "desc": "mass"}, "r": {"unit": "m", "desc": "radius"}},
     "outputs": {"I": {"expr": "m*r**2/2", "unit": "kg*m^2"}}},
    {"id": "solid_cylinder_axial", "name": "Solid cylinder/disk about its axis", "variables": {"m": {"unit": "kg", "desc": "mass"}, "r": {"unit": "m", "desc": "radius"}},
     "outputs": {"I": {"expr": "m*r**2/2", "unit": "kg*m^2"}}},
    {"id": "solid_cylinder_transverse", "name": "Solid cylinder about transverse axis through centroid", "variables": {"m": {"unit": "kg", "desc": "mass"}, "r": {"unit": "m", "desc": "radius"}, "L": {"unit": "m", "desc": "length"}},
     "outputs": {"I": {"expr": "m*(3*r**2 + L**2)/12", "unit": "kg*m^2"}}},
    {"id": "hollow_cylinder_axial", "name": "Thick-walled tube about its axis", "variables": {"m": {"unit": "kg", "desc": "mass"}, "r_o": {"unit": "m", "desc": "outer radius"}, "r_i": {"unit": "m", "desc": "inner radius"}},
     "outputs": {"I": {"expr": "m*(r_o**2 + r_i**2)/2", "unit": "kg*m^2"}}},
    {"id": "hollow_cylinder_transverse", "name": "Thick-walled tube about transverse centroidal axis", "variables": {"m": {"unit": "kg", "desc": "mass"}, "r_o": {"unit": "m", "desc": "outer radius"}, "r_i": {"unit": "m", "desc": "inner radius"}, "L": {"unit": "m", "desc": "length"}},
     "outputs": {"I": {"expr": "m*(3*(r_o**2 + r_i**2) + L**2)/12", "unit": "kg*m^2"}}},
    {"id": "solid_disk_diameter", "name": "Thin solid disk about a diameter", "variables": {"m": {"unit": "kg", "desc": "mass"}, "r": {"unit": "m", "desc": "radius"}},
     "outputs": {"I": {"expr": "m*r**2/4", "unit": "kg*m^2"}}},
    {"id": "solid_sphere", "name": "Solid sphere about a diameter", "variables": {"m": {"unit": "kg", "desc": "mass"}, "r": {"unit": "m", "desc": "radius"}},
     "outputs": {"I": {"expr": "2*m*r**2/5", "unit": "kg*m^2"}}},
    {"id": "thin_spherical_shell", "name": "Thin spherical shell (e.g. ping-pong ball) about a diameter", "variables": {"m": {"unit": "kg", "desc": "mass"}, "r": {"unit": "m", "desc": "radius"}},
     "outputs": {"I": {"expr": "2*m*r**2/3", "unit": "kg*m^2"}}},
    {"id": "thick_spherical_shell", "name": "Thick spherical shell about a diameter", "variables": {"m": {"unit": "kg", "desc": "mass"}, "r_o": {"unit": "m", "desc": "outer radius"}, "r_i": {"unit": "m", "desc": "inner radius"}},
     "outputs": {"I": {"expr": "2*m*(r_o**5 - r_i**5)/(5*(r_o**3 - r_i**3))", "unit": "kg*m^2"}}},
    {"id": "thin_rod_center", "name": "Slender rod about transverse axis through centre", "variables": {"m": {"unit": "kg", "desc": "mass"}, "L": {"unit": "m", "desc": "length"}},
     "outputs": {"I": {"expr": "m*L**2/12", "unit": "kg*m^2"}}},
    {"id": "thin_rod_end", "name": "Slender rod about transverse axis through one end (robot link)", "variables": {"m": {"unit": "kg", "desc": "mass"}, "L": {"unit": "m", "desc": "length"}},
     "outputs": {"I": {"expr": "m*L**2/3", "unit": "kg*m^2"}}},
    {"id": "cuboid_center", "name": "Solid cuboid about axis through centroid parallel to c (a, b are the other two sides)", "variables": {"m": {"unit": "kg", "desc": "mass"}, "a": {"unit": "m", "desc": "side perpendicular to axis"}, "b": {"unit": "m", "desc": "other side perpendicular to axis"}},
     "outputs": {"I": {"expr": "m*(a**2 + b**2)/12", "unit": "kg*m^2"}}},
    {"id": "rect_plate_edge", "name": "Thin rectangular plate about an edge (hinged door/flap), a = width perpendicular to hinge", "variables": {"m": {"unit": "kg", "desc": "mass"}, "a": {"unit": "m", "desc": "width away from hinge"}},
     "outputs": {"I": {"expr": "m*a**2/3", "unit": "kg*m^2"}}},
    {"id": "solid_cone_axial", "name": "Solid right cone about its axis", "variables": {"m": {"unit": "kg", "desc": "mass"}, "r": {"unit": "m", "desc": "base radius"}},
     "outputs": {"I": {"expr": "3*m*r**2/10", "unit": "kg*m^2"}}},
    {"id": "solid_cone_apex_transverse", "name": "Solid cone about transverse axis through apex", "variables": {"m": {"unit": "kg", "desc": "mass"}, "r": {"unit": "m", "desc": "base radius"}, "h": {"unit": "m", "desc": "height"}},
     "outputs": {"I": {"expr": "3*m*(r**2/20 + h**2/5)", "unit": "kg*m^2"}}},
    {"id": "solid_torus_axial", "name": "Solid torus about symmetry axis (R = centre-circle radius, a = tube radius)", "variables": {"m": {"unit": "kg", "desc": "mass"}, "R": {"unit": "m", "desc": "major radius"}, "a": {"unit": "m", "desc": "tube radius"}},
     "outputs": {"I": {"expr": "m*(R**2 + 3*a**2/4)", "unit": "kg*m^2"}}},
    {"id": "parallel_axis", "name": "Parallel axis theorem", "variables": {"I_cm": {"unit": "kg*m^2", "desc": "inertia about parallel centroidal axis"}, "m": {"unit": "kg", "desc": "mass"}, "d": {"unit": "m", "desc": "axis offset"}},
     "outputs": {"I": {"expr": "I_cm + m*d**2", "unit": "kg*m^2"}}},
    {"id": "reflected_through_gearbox", "name": "Load inertia reflected to motor through ratio N (N = motor speed / load speed)", "variables": {"J_load": {"unit": "kg*m^2", "desc": "load inertia"}, "N": {"unit": "1", "desc": "reduction ratio"}, "eta": {"unit": "1", "desc": "efficiency (use 1 if unknown)"}},
     "outputs": {"J_reflected": {"expr": "J_load/(eta*N**2)", "unit": "kg*m^2"}}},
    {"id": "linear_mass_on_leadscrew", "name": "Linear mass reflected to screw shaft", "variables": {"m": {"unit": "kg", "desc": "moving mass"}, "lead": {"unit": "m", "desc": "travel per revolution"}},
     "outputs": {"J_reflected": {"expr": "m*(lead/(2*pi))**2", "unit": "kg*m^2"}}},
    {"id": "linear_mass_on_pulley", "name": "Linear mass on belt/rack reflected to pulley/pinion of pitch radius r", "variables": {"m": {"unit": "kg", "desc": "moving mass"}, "r": {"unit": "m", "desc": "pitch radius"}},
     "outputs": {"J_reflected": {"expr": "m*r**2", "unit": "kg*m^2"}}},
    {"id": "inertia_ratio", "name": "Load-to-motor inertia ratio (servo tuning rule of thumb < 10:1, steppers < ~5:1)", "variables": {"J_reflected": {"unit": "kg*m^2", "desc": "reflected load inertia"}, "J_motor": {"unit": "kg*m^2", "desc": "rotor inertia"}},
     "outputs": {"ratio": {"expr": "J_reflected/J_motor", "unit": "1"}}},
    {"id": "torque_to_accelerate", "name": "Torque to angularly accelerate total inertia", "variables": {"J": {"unit": "kg*m^2", "desc": "total inertia at shaft"}, "alpha": {"unit": "rad/s^2", "desc": "angular acceleration"}},
     "outputs": {"T": {"expr": "J*alpha", "unit": "N*m"}}}
  ]
}
