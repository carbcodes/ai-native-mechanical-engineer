{
  "meta": {
    "description": "Small-deflection Euler-Bernoulli beam cases plus basic axial/torsion/buckling. Expressions are Python syntax; SI (N, m, Pa, m^4). P = point load (N), w = distributed load (N/m), positive deflection = in load direction.",
    "source_url": "https://en.wikipedia.org/wiki/Deflection_(engineering)",
    "value_type": "handbook_typical"
  },
  "formulas": [
    {"id": "cantilever_end_load", "name": "Cantilever, point load P at free end",
     "variables": {"P": {"unit": "N", "desc": "end load"}, "L": {"unit": "m", "desc": "length"}, "E": {"unit": "Pa", "desc": "Young's modulus"}, "I": {"unit": "m^4", "desc": "second moment of area"}},
     "outputs": {"delta_max": {"expr": "P*L**3/(3*E*I)", "unit": "m"}, "theta_max": {"expr": "P*L**2/(2*E*I)", "unit": "rad"}, "M_max": {"expr": "P*L", "unit": "N*m"}, "V_max": {"expr": "P", "unit": "N"}, "k": {"expr": "3*E*I/L**3", "unit": "N/m"}}},
    {"id": "cantilever_load_at_a", "name": "Cantilever, point load P at distance a from fixed end",
     "variables": {"P": {"unit": "N", "desc": "load"}, "a": {"unit": "m", "desc": "load position from wall"}, "L": {"unit": "m", "desc": "length"}, "E": {"unit": "Pa", "desc": "Young's modulus"}, "I": {"unit": "m^4", "desc": "second moment of area"}},
     "outputs": {"delta_tip": {"expr": "P*a**2*(3*L - a)/(6*E*I)", "unit": "m"}, "delta_at_load": {"expr": "P*a**3/(3*E*I)", "unit": "m"}, "M_max": {"expr": "P*a", "unit": "N*m"}}},
    {"id": "cantilever_udl", "name": "Cantilever, uniform load w over full length",
     "variables": {"w": {"unit": "N/m", "desc": "distributed load"}, "L": {"unit": "m", "desc": "length"}, "E": {"unit": "Pa", "desc": "Young's modulus"}, "I": {"unit": "m^4", "desc": "second moment of area"}},
     "outputs": {"delta_max": {"expr": "w*L**4/(8*E*I)", "unit": "m"}, "theta_max": {"expr": "w*L**3/(6*E*I)", "unit": "rad"}, "M_max": {"expr": "w*L**2/2", "unit": "N*m"}, "V_max": {"expr": "w*L", "unit": "N"}}},
    {"id": "cantilever_end_moment", "name": "Cantilever, moment M0 at free end",
     "variables": {"M0": {"unit": "N*m", "desc": "end moment"}, "L": {"unit": "m", "desc": "length"}, "E": {"unit": "Pa", "desc": "Young's modulus"}, "I": {"unit": "m^4", "desc": "second moment of area"}},
     "outputs": {"delta_max": {"expr": "M0*L**2/(2*E*I)", "unit": "m"}, "theta_max": {"expr": "M0*L/(E*I)", "unit": "rad"}, "M_max": {"expr": "M0", "unit": "N*m"}}},
    {"id": "simply_supported_center_load", "name": "Simply supported, point load P at midspan",
     "variables": {"P": {"unit": "N", "desc": "load"}, "L": {"unit": "m", "desc": "span"}, "E": {"unit": "Pa", "desc": "Young's modulus"}, "I": {"unit": "m^4", "desc": "second moment of area"}},
     "outputs": {"delta_max": {"expr": "P*L**3/(48*E*I)", "unit": "m"}, "theta_end": {"expr": "P*L**2/(16*E*I)", "unit": "rad"}, "M_max": {"expr": "P*L/4", "unit": "N*m"}, "V_max": {"expr": "P/2", "unit": "N"}, "k": {"expr": "48*E*I/L**3", "unit": "N/m"}}},
    {"id": "simply_supported_load_at_a", "name": "Simply supported, point load P at distance a from left support",
     "variables": {"P": {"unit": "N", "desc": "load"}, "a": {"unit": "m", "desc": "load position"}, "L": {"unit": "m", "desc": "span"}, "E": {"unit": "Pa", "desc": "Young's modulus"}, "I": {"unit": "m^4", "desc": "second moment of area"}},
     "outputs": {"delta_at_load": {"expr": "P*a**2*(L - a)**2/(3*E*I*L)", "unit": "m"}, "delta_max": {"expr": "P*min(a, L - a)*(L**2 - min(a, L - a)**2)**1.5/(9*sqrt(3)*L*E*I)", "unit": "m"}, "M_max": {"expr": "P*a*(L - a)/L", "unit": "N*m"}}},
    {"id": "simply_supported_udl", "name": "Simply supported, uniform load w",
     "variables": {"w": {"unit": "N/m", "desc": "distributed load"}, "L": {"unit": "m", "desc": "span"}, "E": {"unit": "Pa", "desc": "Young's modulus"}, "I": {"unit": "m^4", "desc": "second moment of area"}},
     "outputs": {"delta_max": {"expr": "5*w*L**4/(384*E*I)", "unit": "m"}, "theta_end": {"expr": "w*L**3/(24*E*I)", "unit": "rad"}, "M_max": {"expr": "w*L**2/8", "unit": "N*m"}, "V_max": {"expr": "w*L/2", "unit": "N"}}},
    {"id": "fixed_fixed_center_load", "name": "Both ends fixed, point load P at midspan",
     "variables": {"P": {"unit": "N", "desc": "load"}, "L": {"unit": "m", "desc": "span"}, "E": {"unit": "Pa", "desc": "Young's modulus"}, "I": {"unit": "m^4", "desc": "second moment of area"}},
     "outputs": {"delta_max": {"expr": "P*L**3/(192*E*I)", "unit": "m"}, "M_max": {"expr": "P*L/8", "unit": "N*m"}}},
    {"id": "fixed_fixed_udl", "name": "Both ends fixed, uniform load w",
     "variables": {"w": {"unit": "N/m", "desc": "distributed load"}, "L": {"unit": "m", "desc": "span"}, "E": {"unit": "Pa", "desc": "Young's modulus"}, "I": {"unit": "m^4", "desc": "second moment of area"}},
     "outputs": {"delta_max": {"expr": "w*L**4/(384*E*I)", "unit": "m"}, "M_max": {"expr": "w*L**2/12", "unit": "N*m"}}},
    {"id": "propped_cantilever_center_load", "name": "Fixed-pinned, point load P at midspan",
     "variables": {"P": {"unit": "N", "desc": "load"}, "L": {"unit": "m", "desc": "span"}, "E": {"unit": "Pa", "desc": "Young's modulus"}, "I": {"unit": "m^4", "desc": "second moment of area"}},
     "outputs": {"delta_max": {"expr": "P*L**3/(48*sqrt(5)*E*I)", "unit": "m"}, "M_max": {"expr": "3*P*L/16", "unit": "N*m"}}},
    {"id": "propped_cantilever_udl", "name": "Fixed-pinned, uniform load w",
     "variables": {"w": {"unit": "N/m", "desc": "distributed load"}, "L": {"unit": "m", "desc": "span"}, "E": {"unit": "Pa", "desc": "Young's modulus"}, "I": {"unit": "m^4", "desc": "second moment of area"}},
     "outputs": {"delta_max": {"expr": "w*L**4/(185*E*I)", "unit": "m"}, "M_max": {"expr": "w*L**2/8", "unit": "N*m"}}},
    {"id": "bending_stress", "name": "Bending stress at distance c from neutral axis",
     "variables": {"M": {"unit": "N*m", "desc": "bending moment"}, "c": {"unit": "m", "desc": "extreme fibre distance"}, "I": {"unit": "m^4", "desc": "second moment of area"}},
     "outputs": {"sigma": {"expr": "M*c/I", "unit": "Pa"}}},
    {"id": "axial_bar", "name": "Axially loaded bar",
     "variables": {"P": {"unit": "N", "desc": "axial load"}, "L": {"unit": "m", "desc": "length"}, "A": {"unit": "m^2", "desc": "area"}, "E": {"unit": "Pa", "desc": "Young's modulus"}},
     "outputs": {"delta": {"expr": "P*L/(A*E)", "unit": "m"}, "sigma": {"expr": "P/A", "unit": "Pa"}, "k": {"expr": "A*E/L", "unit": "N/m"}}},
    {"id": "torsion_round", "name": "Round shaft in torsion",
     "variables": {"T": {"unit": "N*m", "desc": "torque"}, "L": {"unit": "m", "desc": "length"}, "J": {"unit": "m^4", "desc": "polar moment"}, "G": {"unit": "Pa", "desc": "shear modulus"}, "r": {"unit": "m", "desc": "outer radius"}},
     "outputs": {"theta": {"expr": "T*L/(G*J)", "unit": "rad"}, "tau_max": {"expr": "T*r/J", "unit": "Pa"}, "k_t": {"expr": "G*J/L", "unit": "N*m/rad"}}},
    {"id": "euler_buckling", "name": "Euler column buckling; K = 2 fixed-free, 1 pinned-pinned, 0.699 fixed-pinned, 0.5 fixed-fixed (use design K ~0.65/0.8/2.1 per AISC)",
     "variables": {"E": {"unit": "Pa", "desc": "Young's modulus"}, "I": {"unit": "m^4", "desc": "least second moment of area"}, "K": {"unit": "1", "desc": "effective length factor"}, "L": {"unit": "m", "desc": "length"}},
     "outputs": {"P_cr": {"expr": "pi**2*E*I/(K*L)**2", "unit": "N"}},
     "notes": "Valid for slender columns only (slenderness above the Johnson transition)."}
  ]
}
